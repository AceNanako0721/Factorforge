  {
   "version": "2.21.0",
   "change_kind": "specification",
   "date": "2026-10-30",
   "summary": "Rewrite the specification and design books from the current code as Markdown; keep only the current baseline in the tree (earlier versions via tags); neutral example values; retire the v1.1 contracts. Fixes: kept protection plans count in the portfolio stress limit; console next-page cursors, stale panels after a failed request and judgment-page export; oversized provider responses are delivery-unknown."
  },
  {
   "version": "2.21.1",
   "change_kind": "design",
   "date": "2026-10-31",
   "summary": "Strategy store: a failed binding query reports STORE_UNAVAILABLE instead of OBJECT_BINDING_CHANGED; only a missing or different binding is a binding change."
  },
  {
   "version": "2.21.2",
   "change_kind": "design",
   "date": "2026-10-31",
   "summary": "Application instance: when no new batch may open (risk fraction not above zero, or every hard stop beyond the insurance stop), the still-valid initial-distance directive is withdrawn by a newer one without a risk fraction, so the strategy layer opens no batch from the old one. Documentation describes local configuration, prompts and credentials in plain terms; unused test fixtures removed."
  }
