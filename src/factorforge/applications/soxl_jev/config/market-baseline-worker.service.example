[Unit]
Description=Factorforge P3 market baseline worker
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/PATH/TO/Factorforge
ExecStart=/PATH/TO/Factorforge/runtime/bin/market-baseline-worker --config /PATH/TO/Factorforge/config/config.toml
Restart=on-failure
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
