[Unit]
Description=Factorforge P3 official calendar worker
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/PATH/TO/Factorforge
ExecStart=/PATH/TO/Factorforge/runtime/bin/calendar-worker --config /PATH/TO/Factorforge/config/config.toml
Restart=on-failure
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
