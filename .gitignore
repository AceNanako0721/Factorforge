# Publish only one format template in each private asset directory.
/config/*
!/config/config.example.toml
/prompts/*
!/prompts/prompts.example.json
.env
.env.*
*.pem
*.key
*.p12
*.pfx
private/
.private/
secrets/
# Real analysis prompts and model traces stay private.
model_traces/
ai_cache/
# Local data, trading records, logs and build artifacts
data/raw/
data/private/
runtime/
logs/
backups/
*.sqlite*
*.db
/build/
/dist/
/htmlcov/
.coverage
# Frontend dependencies and generated assets never enter public source.
node_modules/
.vite/
.pnpm-store/
*.tsbuildinfo
*.map
doc/private/
doc/_archive/
~$*
**/~$*
# Original vendor CLI authentication stores must never enter the public tree.
.claude/
.claude.json
.gemini/
.antigravity/
.credentials.json
