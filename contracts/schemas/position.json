{
  "title": "Position",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "instrument_id",
    "signed_quantity",
    "quantity_unit",
    "as_of_utc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "instrument_id": {
      "const": "SOXLUSDT"
    },
    "signed_quantity": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "quantity_unit": {
      "type": "string",
      "minLength": 1
    },
    "as_of_utc": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 UTC, suffix Z"
    },
    "protected_quantity": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "target_quantity": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
