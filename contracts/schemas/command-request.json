{
  "title": "CommandRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reason",
    "expected_state_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "expected_state_version": {
      "type": "integer",
      "minimum": 0
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
