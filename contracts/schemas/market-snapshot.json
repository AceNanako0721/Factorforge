{
  "title": "MarketSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instrument_id",
    "as_of_utc",
    "quality",
    "prices"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "instrument_id": {
      "const": "SOXLUSDT"
    },
    "as_of_utc": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 UTC, suffix Z"
    },
    "exchange_business_date": {
      "type": "string",
      "format": "date"
    },
    "quality": {
      "enum": [
        "VALID",
        "STALE",
        "GAP",
        "UNKNOWN"
      ]
    },
    "prices": {
      "type": "object",
      "additionalProperties": {
        "title": "TypedPrice",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "unit",
          "available_at_utc"
        ],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "available_at_utc": {
            "type": "string",
            "format": "date-time",
            "description": "RFC3339 UTC, suffix Z"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_manifest_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
