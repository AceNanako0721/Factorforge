{
  "title": "AnalysisRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_run_id",
    "evidence_ids",
    "evidence_hashes",
    "claim_ids",
    "available_at_utc",
    "target_instrument",
    "question_set_version",
    "prompt_version",
    "requested_model"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "analysis_run_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "available_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "target_instrument": {
      "const": "SOXLUSDT"
    },
    "question_set_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
