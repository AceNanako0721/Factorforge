{
  "title": "SignalEligibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "analysis_run_id",
    "evidence_hashes",
    "environment_id",
    "account_id",
    "strategy_id",
    "instrument_id",
    "eligibility",
    "gate_version",
    "issued_at_utc",
    "expires_at_utc",
    "issuer_workload_identity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_run_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment_id": {
      "enum": [
        "SIM",
        "LIVE"
      ]
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "instrument_id": {
      "const": "SOXLUSDT"
    },
    "eligibility": {
      "enum": [
        "VERIFIED",
        "ELIGIBLE_FOR_SIM",
        "ELIGIBLE_FOR_LIVE",
        "REVOKED"
      ]
    },
    "gate_version": {
      "type": "string",
      "minLength": 1
    },
    "issued_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "issuer_workload_identity": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
