{
  "title": "AnalysisJobRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_ids",
    "target_instrument",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_instrument": {
      "const": "SOXLUSDT"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
