{
  "title": "ResearchCandidateSubmission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_ids",
    "asserted_claim_ids",
    "proposed_event_type",
    "proposed_direction",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "asserted_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_event_type": {
      "type": "string",
      "minLength": 1
    },
    "proposed_direction": {
      "enum": [
        "UP",
        "DOWN",
        "NEUTRAL",
        "UNKNOWN"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
