  "info": {
    "title": "Factorforge instance read API",
    "version": "instance-2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/instances/{instance_id}/dynamic/actions": {
      "get": {
        "operationId": "read_instance_dynamic_actions",
        "parameters": [
          {
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_.-]{1,128}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "schema": {
              "format": "date-time",
              "minLength": 1,
              "pattern": "Z$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "format": "date-time",
              "minLength": 1,
              "pattern": "Z$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "cursor": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "environment": {
                      "enum": [
                        "SIM",
                        "LIVE"
                      ],
                      "type": "string"
                    },
                    "instance_id": {
                      "type": "string"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/DynamicActionView"
                      },
                      "type": "array"
                    },
                    "observed_at": {
                      "anyOf": [
                        {
                          "format": "date-time",
                          "pattern": "Z$",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "schema_version": {
                      "const": "instance-2.0",
                      "type": "string"
                    },
                    "snapshot_version": {
                      "type": "string"
                    },
                    "source_version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "environment",
                    "instance_id",
                    "source_version",
                    "observed_at",
                    "snapshot_version",
                    "items",
                    "cursor"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Recorded instance facts; unknown timestamps and measurements remain null"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stable error code; no private values"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stable error code; no private values"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stable error code; no private values"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stable error code; no private values"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stable error code; no private values"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stable error code; no private values"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
