{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorforge.local/contracts/model-access/generate-response-v2",
  "title": "Single JSONL v2 generation reply; candidate text is untrusted",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["v", "id", "ok", "result"],
      "properties": {
        "v": {"const": 2}, "id": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}$"}, "ok": {"const":true},
        "result": {
          "type":"object", "additionalProperties":false,
          "required":["provider","account_id","model","text","usage","prompt_hash"],
          "properties": {
            "provider":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]{0,127}$"},
            "account_id":{"type":"integer","minimum":1,"maximum":9007199254740991},
            "model":{"type":"string","minLength":1,"maxLength":256},
            "text":{"type":"string","minLength":1},
            "prompt_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
            "usage":{"type":"object","additionalProperties":false,"properties":{
              "input":{"type":"number","minimum":0,"maximum":9007199254740991},
              "output":{"type":"number","minimum":0,"maximum":9007199254740991},
              "totalTokens":{"type":"number","minimum":0,"maximum":9007199254740991}
            }}
          }
        }
      }
    },
    {
      "type":"object","additionalProperties":false,"required":["v","id","ok","error"],
      "properties":{
        "v":{"const":2},"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}$"},"ok":{"const":false},
        "error":{"type":"object","additionalProperties":false,"required":["code","delivery_unknown"],"properties":{
          "code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},"delivery_unknown":{"type":"boolean"}
        }}
      }
    }
  ]
}
